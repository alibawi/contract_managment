{
  "name": "contracts-mock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "esbuild scripts/integrity-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/integrity-check.mjs --log-level=warning && node node_modules/.cache/integrity-check.mjs",
    "check:agreements": "esbuild scripts/flow-agreements.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/flow.mjs --log-level=warning && node node_modules/.cache/flow.mjs",
    "check:amendments": "esbuild scripts/flow-amendments.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/flowa.mjs --log-level=warning && node node_modules/.cache/flowa.mjs",
    "check:finance": "esbuild scripts/flow-finance.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/flowf.mjs --log-level=warning && node node_modules/.cache/flowf.mjs",
    "check:templates": "esbuild scripts/flow-templates.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/flowt.mjs --log-level=warning && node node_modules/.cache/flowt.mjs",
    "check:service": "esbuild scripts/flow-service.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/flows.mjs --log-level=warning && node node_modules/.cache/flows.mjs"
  },
  "dependencies": {
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
